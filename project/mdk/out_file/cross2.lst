  467          /*--------------------------------------------------------------------------
  468           * _cr_repair_both - 双侧补线
  469           *
  470           * 策略:
  471           *   对每一侧，如果存在断口/断点:
  472           *     1. 取断点上方 FIT_LEN 行做最小二乘拟合
  473           *     2. 从断点处向下延伸到图像底部
  474           *   如果无断口（已经在 RECOVER 阶段）:
  475           *     不修改边线
  476           *   额外兜底: 如果丢线过多，强制补线（用对侧边线 - 估计宽度）
  477           *--------------------------------------------------------------------------*/
  478          static void _cr_repair_both(uint16 *l, uint16 *r, Cross2Feature *f)
  479          {
  480   1          uint8 row;
  481   1          uint8 l_bp; 
  482   1          uint8 r_bp;
  483   1          uint16 est_w;
  484   1          float k;
  485   1          float b;
  486   1          /* 确定左侧断点行: 优先用边线断口，备选链码断点 */
  487   1          l_bp = f->l_break_row;
  488   1          if (!l_bp) l_bp = f->l_dir_break_row;
  489   1      
  490   1          /* 确定右侧断点行 */
  491   1          r_bp = f->r_break_row;
  492   1          if (!r_bp) r_bp = f->r_dir_break_row;
  493   1      
  494   1          /* ---------- 左侧补线 ---------- */
  495   1          if (l_bp > CROSS2_FIT_LEN + CROSS2_SCAN_TOP)
  496   1          {
  497   2              k = f->l_slope;
  498   2              b = f->l_intercept;
  499   2      
  500   2              /* 从断点往下补到底部 */
  501   2              for (row = l_bp; row <= CROSS2_SCAN_BOT; row++)
  502   2              {
  503   3                  int16 val = (int16)(k * row + b);
  504   3                  l[row] = (uint16)CLAMP(val, BORDER_MIN, BORDER_MAX);
  505   3              }
  506   2          }
  507   1          else if (f->l_lost_cnt > CROSS2_LOST_THRESH)
  508   1          {
  509   2              /* 大面积丢线兜底: 用右边线 - 底部宽度估计 */
  510   2              est_w = f->width_bottom;
  511   2              if (est_w < 20) est_w = 20;
  512   2              for (row = CROSS2_SCAN_TOP; row <= CROSS2_SCAN_BOT; row++)
  513   2              {
  514   3                  if (l[row] <= BORDER_MIN + 1)
