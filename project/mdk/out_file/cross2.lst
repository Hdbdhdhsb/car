  445           * _cr_check_entry - IDLE→CROSSING 条件
  446           *
  447           * 十字入口特征（要求双侧同时异常，区别于圆环单侧异常）:
  448           *   方案A: 双侧边线断口同时存在
  449           *   方案B: 双侧链码断点同时存在
  450           *   方案C: 过宽行数足够多 + 底部角落为白色（排除全黑干扰）
  451           *
  452           * 额外排除: 如果只有一侧断口，不认为是十字（留给圆环处理）
  453           *--------------------------------------------------------------------------*/
  454          static uint8 _cr_check_entry(Cross2Feature *f)
  455          {
  456   1          /* 方案A: 边线跳变双侧都有 */
  457   1          uint8 both_break = (f->l_break_row > 0 && f->r_break_row > 0) ? 1 : 0;
  458   1      
  459   1          /* 方案B: 链码双侧都有断点 */
  460   1          uint8 both_dir   = (f->l_dir_break_row > 0 && f->r_dir_break_row > 0) ? 1 : 0;
  461   1      
  462   1          /* 方案C: 宽度模型判据 */
  463   1          uint8 width_wide = (f->wide_cnt >= CROSS2_WIDE_CNT_MIN) ? 1 : 0;
  464   1      
  465   1          /* 底部角落验证: 十字底部通常是白色（赛道内） */
  466   1          uint8 bottom_ok  = (f->corner_bl == WHITE_PIXEL && f->corner_br == WHITE_PIXEL) ? 1 : 0;
  467   1      
  468   1          /* 排除单侧断口（那更可能是圆环） */
  469   1          uint8 single_side = ((f->l_break_row > 0) ^ (f->r_break_row > 0)) ? 1 : 0;
  470   1          uint8 score = 0;
  471   1          if (single_side) return 0;
  472   1      
  473   1          /* 三选二: 满足两个方案则为圆环 */
  474   1          if (both_break) score++;
  475   1          if (both_dir)   score++;
  476   1          if (width_wide && bottom_ok) score++;
  477   1      
  478   1          return (score >= 1) ? 1 : 0;
  479   1      }
