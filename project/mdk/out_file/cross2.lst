  400          /*--------------------------------------------------------------------------
  401           * _cr_check_entry - IDLE→CROSSING 条件
  402           *
  403           * 十字入口特征（要求双侧同时异常，区别于圆环单侧异常）:
  404           *   方案A: 双侧边线断口同时存在
  405           *   方案B: 双侧链码断点同时存在
  406           *   方案C: 过宽行数足够多 + 底部角落为白色（排除全黑干扰）
  407           *
  408           * 额外排除: 如果只有一侧断口，不认为是十字（留给圆环处理）
  409           *--------------------------------------------------------------------------*/
  410          static uint8 _cr_check_entry(Cross2Feature *f)
  411          {
  412   1          /* 方案A: 边线跳变双侧都有 */
  413   1          uint8 both_break = (f->l_break_row > 0 && f->r_break_row > 0) ? 1 : 0;
  414   1      
  415   1          /* 方案B: 链码双侧都有断点 */
  416   1          uint8 both_dir   = (f->l_dir_break_row > 0 && f->r_dir_break_row > 0) ? 1 : 0;
  417   1      
  418   1          /* 方案C: 宽度模型判据 */
  419   1          uint8 width_wide = (f->wide_cnt >= CROSS2_WIDE_CNT_MIN) ? 1 : 0;
  420   1      
  421   1          /* 底部角落验证: 十字底部通常是白色（赛道内） */
  422   1          uint8 bottom_ok  = (f->corner_bl == WHITE_PIXEL && f->corner_br == WHITE_PIXEL) ? 1 : 0;
  423   1      
  424   1          /* 排除单侧断口（那更可能是圆环） */
  425   1          uint8 single_side = ((f->l_break_row > 0) ^ (f->r_break_row > 0)) ? 1 : 0;
  426   1          uint8 score = 0;
  427   1          if (single_side) return 0;
  428   1      
  429   1          /* 三选二: 满足两个方案则为圆环 */
  430   1          if (both_break) score++;
  431   1          if (both_dir)   score++;
  432   1          if (width_wide && bottom_ok) score++;
  433   1      
  434   1          return (score >= 2) ? 1 : 0;
  435   1      }
