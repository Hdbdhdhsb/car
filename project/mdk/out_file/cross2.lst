  542   4                      int16 val = (int16)l[row] + (int16)est_w;
  543   4                      r[row] = (uint16)CLAMP(val, BORDER_MIN, BORDER_MAX);
  544   4                  }
  545   3              }
  546   2          }
  547   1      }
