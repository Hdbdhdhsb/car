  455           *   方案A: 双侧边线断口同时存在
  456           *   方案B: 双侧链码断点同时存在
  457           *   方案C: 过宽行数足够多 + 底部角落为白色（排除全黑干扰）
  458           *
  459           * 额外排除: 如果只有一侧断口，不认为是十字（留给圆环处理）
  460           *--------------------------------------------------------------------------*/
  461          static uint8 _cr_check_entry(Cross2Feature *f)
  462          {
  463   1          /* 方案A: 边线跳变双侧都有 */
  464   1          uint8 both_break = (f->l_break_row > 0 && f->r_break_row > 0) ? 1 : 0;
  465   1      
  466   1          /* 方案B: 链码双侧都有断点 */
  467   1          uint8 both_dir   = (f->l_dir_break_row > 0 && f->r_dir_break_row > 0) ? 1 : 0;
  468   1      
  469   1          /* 方案C: 宽度模型判据 */
  470   1          uint8 width_wide = (f->wide_cnt >= CROSS2_WIDE_CNT_MIN) ? 1 : 0;
  471   1      
  472   1          /* 底部角落验证: 十字底部通常是白色（赛道内） */
  473   1          uint8 bottom_ok  = (f->corner_bl == WHITE_PIXEL && f->corner_br == WHITE_PIXEL) ? 1 : 0;
  474   1      
  475   1          /* 排除单侧断口（那更可能是圆环） */
  476   1          uint8 single_side = ((f->l_break_row > 0) ^ (f->r_break_row > 0)) ? 1 : 0;
  477   1          uint8 score = 0;
  478   1          if (single_side) return 0;
  479   1      
  480   1          /* 三选二: 至少满足两个方案才认为是十字 */
  481   1          if (both_break) score++;
  482   1          if (both_dir)   score++;
  483   1          if (width_wide && bottom_ok) score++;
  484   1      
  485   1          return (score >= 2) ? 1 : 0;
  486   1      }
