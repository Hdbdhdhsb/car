  343          /*--------------------------------------------------------------------------
  344           * _cr_calc_slope - 在断点上方做最小二乘线性拟合
  345           *
  346           * 取 [break_row - FIT_LEN, break_row - 2] 这段边线数据拟合 y = k*x + b
  347           * 用于向下延伸补线
  348           *--------------------------------------------------------------------------*/
  349          static void _cr_calc_slope(uint16 *border, uint8 break_row, float *slope, float *intercept)
  350          {
  351   1          int16  i;
  352   1          uint8  start_row = break_row - CROSS2_FIT_LEN;
  353   1          uint8  end_row   = break_row - 2;
  354   1          float  sum_x  = 0;
  355   1          float  sum_y  = 0;
  356   1          float  sum_xy = 0;
  357   1          float  sum_x2 = 0;
  358   1          float  n = 0;
  359   1          float  x;
  360   1          float  y;
  361   1          float  denom;
  362   1      
  363   1          if (start_row < CROSS2_SCAN_TOP)
  364   1              start_row = CROSS2_SCAN_TOP;
  365   1          if (end_row <= start_row)
  366   1          {
  367   2              *slope     = 0;
  368   2              *intercept = (float)border[break_row];
  369   2              return;
  370   2          }
  371   1      
  372   1          for (i = start_row; i <= end_row; i++)
  373   1          {
  374   2              x = (float)i;
  375   2              y = (float)border[i];
  376   2              sum_x  += x;
  377   2              sum_y  += y;
  378   2              sum_xy += x * y;
  379   2              sum_x2 += x * x;
  380   2              n      += 1.0f;
  381   2          }
  382   1      
C251 COMPILER V5.60.0,  cross2                                                             21/05/26  14:44:21  PAGE 7   

  383   1          denom = n * sum_x2 - sum_x * sum_x;
  384   1          if (denom > 0.001f || denom < -0.001f)
  385   1          {
  386   2              *slope     = (n * sum_xy - sum_x * sum_y) / denom;
  387   2              *intercept = (sum_y - (*slope) * sum_x) / n;
  388   2          }
  389   1          else
  390   1          {
  391   2              *slope     = 0;
  392   2              *intercept = (float)border[break_row];
  393   2          }
  394   1      }
