  211          static void _cr_extract_break(uint16 *l, uint16 *r, Cross2Feature *f)
  212          {
  213   1          uint8 row;
  214   1      
  215   1          /* 左边线断口: l[row] 突然变小（向画面左侧跳） */
  216   1          for (row = CROSS2_SCAN_BOT; row > CROSS2_SCAN_TOP + 1; row--)
  217   1          {
  218   2              int16 delta = (int16)l[row] - (int16)l[row - 1];
  219   2              if (delta > CROSS2_BREAK_THRESH)
  220   2              {
  221   3                  f->l_break_row   = row;
  222   3                  f->l_break_delta = delta;
  223   3                  break;
  224   3              }
  225   2          }
  226   1      
  227   1          /* 右边线断口: r[row] 突然变大（向画面右侧跳） */
  228   1          for (row = CROSS2_SCAN_BOT; row > CROSS2_SCAN_TOP + 1; row--)
  229   1          {
  230   2              int16 delta = (int16)r[row - 1] - (int16)r[row];
  231   2              if (delta > CROSS2_BREAK_THRESH)
  232   2              {
  233   3                  f->r_break_row   = row;
  234   3                  f->r_break_delta = delta;
  235   3                  break;
  236   3              }
  237   2          }
  238   1      }
