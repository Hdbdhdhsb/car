  515   3                  {
  516   4                      int16 val = (int16)r[row] - (int16)est_w;
  517   4                      l[row] = (uint16)CLAMP(val, BORDER_MIN, BORDER_MAX);
  518   4                  }
  519   3              }
  520   2          }
  521   1      
  522   1          /* ---------- 右侧补线 ---------- */
  523   1          if (r_bp > CROSS2_FIT_LEN + CROSS2_SCAN_TOP)
  524   1          {
  525   2              k = f->r_slope;
  526   2              b = f->r_intercept;
  527   2      
  528   2              for (row = r_bp; row <= CROSS2_SCAN_BOT; row++)
  529   2              {
  530   3                  int16 val = (int16)(k * row + b);
  531   3                  r[row] = (uint16)CLAMP(val, BORDER_MIN, BORDER_MAX);
  532   3              }
  533   2          }
  534   1          else if (f->r_lost_cnt > CROSS2_LOST_THRESH)
  535   1          {
  536   2              est_w = f->width_bottom;
  537   2              if (est_w < 20) est_w = 20;
  538   2              for (row = CROSS2_SCAN_TOP; row <= CROSS2_SCAN_BOT; row++)
  539   2              {
