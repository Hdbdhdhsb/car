  373          //-------------------------------------------------------------------------------------------------------
             -------------
  374          // 函数简介     串口DMA初始化
  375          // 参数说明     uart_n       串口通道
  376          // 返回参数     void
  377          // 使用示例     uart_dma_init(UART_1);
  378          //-------------------------------------------------------------------------------------------------------
             -------------
  379          void uart_dma_init(uart_index_enum uart_n)
  380          {
  381   1        DMA_URXT_CFG(uart_n)  = 0x00; // DMA TX数据访问优先级最低，关闭DMA发送中断，
  382   1        DMA_URXT_STA(uart_n)  = 0x00; // 清除DMA TX状态
  383   1        DMA_URXT_CR(uart_n)   = 0x00; // 关闭DMA TX
  384   1          
  385   1        DMA_URXR_CFG(uart_n)  = 0x00; // 关闭DMA接收中断
  386   1        DMA_URXR_STA(uart_n)  = 0x00; // 清除DMA RX状态
  387   1        DMA_URXR_CR(uart_n)   = 0x00; // 关闭DMA RX
  388   1      
  389   1        DMA_URXR_AMT(uart_n)  = (1 - 1);                  // 设置接收的字节数
  390   1        DMA_URXR_AMTH(uart_n) = (1 - 1)>>8;                 // 设置接收的字节数
  391   1        DMA_URXR_RXAL(uart_n) = (uint8)((uint16)uart_rx_buff[uart_n]);    // 设置接收缓冲地址
  392   1        DMA_URXR_RXAH(uart_n) = (uint8)((uint16)uart_rx_buff[uart_n] >> 8); // 设置接收缓冲地址
  393   1        DMA_URXR_CFG(uart_n)  = 0x0F;                   // 中断优先级最高，DMA优先级最高
  394   1        DMA_URXR_CR(uart_n)   = 0xA1;                   // 开启DMA RX，清空FIFO
  395   1       
  396   1      }
