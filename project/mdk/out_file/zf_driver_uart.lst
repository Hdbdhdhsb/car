  212          // 函数简介     串口发送数组
  213          // 参数说明     uart_n       串口通道
  214          // 参数说明     buff        要发送的数组地址
  215          // 参数说明     len         数据长度
  216          // 返回参数     void
  217          // 使用示例     uart_write_buffer(UART_1, buff, 10);     //串口1发送10个buff数组。
  218          //-------------------------------------------------------------------------------------------------------
             -------------
  219          void uart_write_buffer(uart_index_enum uart_n, const uint8 *buff, uint16 len)
  220          {
  221   1          #define BUFF_LEN 64
  222   1        
  223   1        // 因UART_DMA只能操作xdata区域的数据，所以，这里新建一个数组，搬移。
  224   1        uint8 xdata tmp_buff[BUFF_LEN] = {0};
  225   1          uint16 tmp_len = 0;
  226   1        while(len)
  227   1        {
  228   2              tmp_len = (len > BUFF_LEN) ? BUFF_LEN : len;        // 计算长度
  229   2              memcpy(tmp_buff, buff, tmp_len);                    // 拷贝
C251 COMPILER V5.60.0,  zf_driver_uart                                                     09/06/26  00:28:44  PAGE 5   

  230   2              len -= tmp_len;                                     // 去掉已经发送的长度
  231   2              buff += tmp_len;                                    // 指针指向后面
  232   2              
  233   2              DMA_URXT_CFG(uart_n)  = 0x00;                     // DMA优先级低
  234   2              DMA_URXT_STA(uart_n)  = 0;                    // 清空标志位
  235   2      
  236   2              DMA_URXT_AMT(uart_n)  = (tmp_len - 1) & 0xff;   // 设置传输总字节数(低8位)：n+1
  237   2              DMA_URXT_AMTH(uart_n) = (tmp_len - 1) >> 8;       // 设置传输总字节数(高8位)：n+1
  238   2              DMA_URXT_TXAH(uart_n) = (uint8)((uint16)tmp_buff >> 8);
  239   2              DMA_URXT_TXAL(uart_n) = (uint8)((uint16)tmp_buff);
  240   2              DMA_URXT_CR(uart_n) = 0xC0;                   // 使能DMA TX功能
  241   2      
  242   2              if(!uart_wait_tx_done(uart_n))
  243   2              {
  244   3                  DMA_URXT_CR(uart_n) = 0x00;
  245   3                  DMA_URXT_STA(uart_n) = 0x00;
  246   3                  return;
  247   3              }
  248   2      
  249   2              DMA_URXT_CR(uart_n) = 0x00;                   // 关闭DMA TX
  250   2        }
  251   1      }
