   72          void DMA_UART1_IRQHandler(void) interrupt DMA_UR1R_VECTOR
   73          {
   74   1          static vuint8 dwon_count = 0;
   75   1      
   76   1          if (DMA_UR1R_STA & 0x01) // 接收完成
   77   1          {
   78   2              DMA_UR1R_STA &= ~0x01;      // 清标志位
   79   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
   80   2      
   81   2              // 程序自动下载
   82   2              if (uart_rx_buff[UART_1][0] == 0x7F)
   83   2              {
   84   3                  if (dwon_count++ > 20)
   85   3                  {
   86   4                      IAP_CONTR = 0x60;
   87   4                  }
   88   3              }
   89   2              else
   90   2              {
   91   3                  dwon_count = 0;
   92   3              }
   93   2      
   94   2              if (uart_rx_handlers[UART_1] != NULL)
   95   2              {
   96   3                  uart_rx_handlers[UART_1](uart_rx_buff[UART_1][0]);
   97   3              }
   98   2          }
   99   1      
  100   1          if (DMA_UR1R_STA & 0x02) // 数据丢弃
  101   1          {
  102   2              DMA_UR1R_STA &= ~0x02;      // 清标志位
  103   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
  104   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  105   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  106   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  107   2          }
  108   1      }
