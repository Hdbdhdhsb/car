  320           *--------------------------------------------------------------------------*/
  321          static void _extract_break(uint16 *l, uint16 *r, Circle2Feature *f)
  322          {
  323   1          uint8 row;
  324   1      
  325   1          /* 左边线断口: 向上扫描，l[row] 突然变小（向左跳） */
  326   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  327   1          {
  328   2              int16 delta = (int16)l[row] - (int16)l[row - 1];
  329   2              if (delta > CIR2_BREAK_THRESH && row > CIR2_BREAK_MIN_ROW)
  330   2              {
  331   3                  f->l_break_row   = row;
  332   3                  f->l_break_delta = delta;
  333   3                  break;
  334   3              }
  335   2          }
  336   1      
  337   1          /* 右边线断口: 向上扫描，r[row] 突然变大（向右跳） */
  338   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  339   1          {
  340   2              int16 delta = (int16)r[row - 1] - (int16)r[row];
  341   2              if (delta > CIR2_BREAK_THRESH && row > CIR2_BREAK_MIN_ROW)
  342   2              {
  343   3                  f->r_break_row   = row;
  344   3                  f->r_break_delta = delta;
  345   3                  break;
  346   3              }
  347   2          }
  348   1      }
