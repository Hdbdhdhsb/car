  327          /*--------------------------------------------------------------------------
  328           * _extract_break - 搜索�?右边线断�?
  329           *
  330           * 断口定义: 相邻行边线值跳变超�?CIR2_BREAK_THRESH
  331           * 从底部向上扫描，找到第一个显著断口即记录
  332           *--------------------------------------------------------------------------*/
  333          static void _extract_break(uint16 *l, uint16 *r, Circle2Feature *f)
  334          {
  335   1          uint8 row;
  336   1      
  337   1          /* 左边线断�? 向上扫描，l[row] 突然变小（向左跳�?*/
  338   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  339   1          {
  340   2              int16 delta = (int16)l[row] - (int16)l[row - 1];
  341   2              if (delta > CIR2_BREAK_THRESH && row > CIR2_BREAK_MIN_ROW)
  342   2              {
  343   3                  f->l_break_row   = row;
  344   3                  f->l_break_delta = delta;
  345   3                  break;
  346   3              }
  347   2          }
  348   1      
  349   1          /* 右边线断�? 向上扫描，r[row] 突然变大（向右跳�?*/
  350   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  351   1          {
  352   2              int16 delta = (int16)r[row - 1] - (int16)r[row];
  353   2              if (delta > CIR2_BREAK_THRESH && row > CIR2_BREAK_MIN_ROW)
  354   2              {
  355   3                  f->r_break_row   = row;
  356   3                  f->r_break_delta = delta;
  357   3                  break;
  358   3              }
  359   2          }
  360   1      }
