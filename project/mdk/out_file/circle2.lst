  332          /*--------------------------------------------------------------------------
  333           * _extract_break - 搜索�?右边线断�?
  334           *
  335           * 断口定义: 相邻行边线值跳变超�?CIR2_BREAK_THRESH
  336           * 从底部向上扫描，找到第一个显著断口即记录
  337           *--------------------------------------------------------------------------*/
  338          static void _extract_break(uint16 *l, uint16 *r, Circle2Feature *f)
  339          {
  340   1          uint8 row;
  341   1      
  342   1          /* 左边线断�? 向上扫描，l[row] 突然变小（向左跳�?*/
  343   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  344   1          {
  345   2              int16 delta = (int16)l[row] - (int16)l[row - 1];
  346   2              if (delta > CIR2_BREAK_THRESH && row > CIR2_BREAK_MIN_ROW)
  347   2              {
  348   3                  f->l_break_row   = row;
  349   3                  f->l_break_delta = delta;
  350   3                  break;
  351   3              }
  352   2          }
  353   1      
  354   1          /* 右边线断�? 向上扫描，r[row] 突然变大（向右跳�?*/
  355   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  356   1          {
  357   2              int16 delta = (int16)r[row - 1] - (int16)r[row];
  358   2              if (delta > CIR2_BREAK_THRESH && row > CIR2_BREAK_MIN_ROW)
  359   2              {
  360   3                  f->r_break_row   = row;
  361   3                  f->r_break_delta = delta;
  362   3                  break;
  363   3              }
  364   2          }
  365   1      }
