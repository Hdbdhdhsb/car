  411   1          {
  412   2              return 0;
  413   2          }
  414   1      
  415   1          if (l[row] <= BORDER_MIN + 1 || l[row - 1] <= BORDER_MIN + 1 ||
  416   1              l[row + CIR2_INFLECT_RANGE] <= BORDER_MIN + 1)
  417   1          {
  418   2              return 0;
  419   2          }
  420   1      
  421   1          break_delta = (int16)l[row] - (int16)l[row - 1];
  422   1          rebound_delta = (int16)l[row] - (int16)l[row + CIR2_INFLECT_RANGE];
  423   1      
