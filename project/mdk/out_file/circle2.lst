  386   1          int16 rise_sum = 0;
  387   1          int16 fall_sum = 0;
  388   1      
  389   1          for (i = 1; i <= CIR2_INFLECT_RANGE; i++)
  390   1          {
  391   2              if (r[row - i] >= BORDER_MAX - 1 || r[row + i] >= BORDER_MAX - 1)
  392   2              {
  393   3                  return 0;
  394   3              }
  395   2      
  396   2              rise_sum += (int16)r[row] - (int16)r[row - i];
  397   2              fall_sum += (int16)r[row + i] - (int16)r[row];
  398   2          }
  399   1      
  400   1          return (rise_sum <= -CIR2_INFLECT_TREND_THRESH &&
  401   1                  fall_sum >= CIR2_INFLECT_TREND_THRESH) ? 1 : 0;
  402   1      }
