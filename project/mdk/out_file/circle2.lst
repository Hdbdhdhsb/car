  362          static uint8 _check_left_inflect_trend(uint16 *l, uint8 row)
  363          {
  364   1          uint8 i;
  365   1          int16 rise_sum = 0;
  366   1          int16 fall_sum = 0;
  367   1      
  368   1          for (i = 1; i <= CIR2_INFLECT_RANGE; i++)
  369   1          {
  370   2              if (l[row - i] <= BORDER_MIN + 1 || l[row + i] <= BORDER_MIN + 1)
  371   2              {
  372   3                  return 0;
  373   3              }
  374   2      
  375   2              rise_sum += (int16)l[row] - (int16)l[row - i];
  376   2              fall_sum += (int16)l[row + i] - (int16)l[row];
  377   2          }
  378   1      
  379   1          return (rise_sum >= CIR2_INFLECT_TREND_THRESH &&
  380   1                  fall_sum <= -CIR2_INFLECT_TREND_THRESH) ? 1 : 0;
  381   1      }
  382          
  383          static uint8 _check_right_inflect_trend(uint16 *r, uint8 row)
  384          {
  385   1          uint8 i;
