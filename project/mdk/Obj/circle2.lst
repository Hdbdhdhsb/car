  258   3              }
  259   2          }
  260   1      
  261   1          /* 右边线断口: 向上扫描，r[row] 突然变大（向右跳） */
  262   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  263   1          {
  264   2              int16 delta = (int16)r[row - 1] - (int16)r[row];
  265   2              if (delta > CIR2_BREAK_THRESH)
  266   2              {
