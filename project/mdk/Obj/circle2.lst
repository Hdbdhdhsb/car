    3          /*******************************************************************************
    4           * circle2.c - 新版圆环处理模块
    5           *
    6           * 4状态机:  IDLE → ENTRY → INSIDE → EXIT → IDLE
    7           *
    8           * 核心思路:
    9           *   1. 特征提取: 每帧扫描一遍边线，提取断口、拐点、宽度模型、丢线统计
   10           *   2. 状态判别: 用提取到的特征在 4 个状态间切换
   11           *   3. 单侧补线: 根据圆环方向，只对断口侧边线做线性插值修复
   12           *   4. 中线优先: 修复后立即重算中线
   13           *
   14           * 与 camera.c 兼容:
   15           *   - 直接操作 l_border / r_border / midline 数组（uint16 类型）
   16           *   - 设置 current_track_type / current_state 来驱动外层状态机
   17           ******************************************************************************/
   18          #define false 0
   19          #define true 1
   20          
   21          /*======================== 全局变量定义 ========================*/
   22          Circle2State  cir2_state   = CIR2_IDLE;
   23          Circle2Dir    cir2_dir     = CIR2_NONE;
   24          uint8         cir2_timeout = 0;
   25          
