  393          static uint8 _check_entry(Circle2Feature *f)
  394          {
  395   1          uint8 left_entry  = 0;
  396   1          uint8 right_entry = 0;
  397   1      
  398   1          /* 左圆环入口 */
  399   1          if (f->l_break_row > 0 &&
  400   1              f->l_break_delta >= CIR2_BREAK_THRESH &&
  401   1              f->r_break_row == 0 &&
  402   1              f->l_inflect_row > 0 &&
  403   1              f->r_lost_cnt < CIR2_LOST_THRESH)
  404   1          {
  405   2              left_entry = 1;
  406   2          }
  407   1      
  408   1          /* 右圆环入口 */
  409   1          if (f->r_break_row > 0 &&
  410   1              f->r_break_delta >= CIR2_BREAK_THRESH &&
  411   1              f->l_break_row == 0 &&
  412   1              f->r_inflect_row > 0 &&
  413   1              f->l_lost_cnt < CIR2_LOST_THRESH)
  414   1          {
  415   2              right_entry = 1;
  416   2          }
  417   1      
  418   1          return (left_entry || right_entry);
  419   1      }
