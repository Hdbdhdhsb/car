   30          static void   _extract_lost(uint16 *l, uint16 *r, uint8 (*img)[MT9V03X_W], Circle2Feature *f);
   31          static void   _extract_corner(uint8 (*img)[MT9V03X_W], Circle2Feature *f);
   32          
   33          static uint8  _check_entry(Circle2Feature *f);
   34          static uint8  _check_inside(Circle2Feature *f);
   35          static uint8  _check_exit(Circle2Feature *f);
   36          
   37          static void   _repair_left(uint16 *l, uint16 *r, Circle2Feature *f);
   38          static void   _repair_right(uint16 *l, uint16 *r, Circle2Feature *f);
   39          static void   _recalc_midline(uint16 *l, uint16 *r);
   40          
