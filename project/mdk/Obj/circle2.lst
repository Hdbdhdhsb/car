  248   1          for (row = CIR2_SCAN_BOT; row > CIR2_SCAN_TOP + 1; row--)
  249   1          {
  250   2              int16 delta = (int16)l[row] - (int16)l[row - 1];
  251   2              if (delta > CIR2_BREAK_THRESH)
  252   2              {
  253   3                  /* l[row] > l[row-1]：上面一行的左边界突然靠左（值变小）
C251 COMPILER V5.60.0,  circle2                                                            12/05/26  23:56:44  PAGE 5   

  254   3                   * 说明左侧出现断口 */
